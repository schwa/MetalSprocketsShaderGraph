// Stdlib.metal
// Generated by gyb - do not edit directly
// Run: gyb --line-directive '' -o Stdlib.metal Stdlib.metal.gyb
%{
scalar_types = [
    # (metal_type, suffix)
    ('float', 'f'),
]

vector_sizes = [2, 3, 4]

ops = [
    ('add', '+'),
    ('sub', '-'),
    ('mul', '*'),
    ('div', '/'),
]

swizzle_components = ['x', 'y', 'z', 'w']
}%

#include <metal_stdlib>
using namespace metal;

namespace shadergraph {

// ============================================================================
// MARK: - Arithmetic Operations (Generated)
// ============================================================================

% for metal_type, suffix in scalar_types:
// --- ${metal_type} scalar-scalar ---
% for op_name, op_symbol in ops:
[[stitchable]] ${metal_type} ${op_name}_${suffix}_${suffix}(${metal_type} a, ${metal_type} b) { return a ${op_symbol} b; }
% end

% for size in vector_sizes:
// --- ${metal_type}${size} vector-vector ---
% for op_name, op_symbol in ops:
[[stitchable]] ${metal_type}${size} ${op_name}_${suffix}${size}_${suffix}${size}(${metal_type}${size} a, ${metal_type}${size} b) { return a ${op_symbol} b; }
% end

// --- ${metal_type}${size} vector-scalar ---
% for op_name, op_symbol in ops:
[[stitchable]] ${metal_type}${size} ${op_name}_${suffix}${size}_${suffix}(${metal_type}${size} a, ${metal_type} b) { return a ${op_symbol} b; }
% end

// --- ${metal_type}${size} swizzles ---
% for i, comp in enumerate(swizzle_components[:size]):
[[stitchable]] ${metal_type} swizzle_${comp}_${suffix}${size}(${metal_type}${size} v) { return v.${comp}; }
% end

% end
% end

// ============================================================================
// MARK: - Math Functions
// ============================================================================

[[stitchable]] float sin_f(float x) { return sin(x); }
[[stitchable]] float cos_f(float x) { return cos(x); }

[[stitchable]] float mix_f(float a, float b, float t) { return mix(a, b, t); }
[[stitchable]] float4 mix_f4(float4 a, float4 b, float t) { return mix(a, b, t); }

// Fused multiply-add: a * b + c
[[stitchable]] float fma_f(float a, float b, float c) { return fma(a, b, c); }
[[stitchable]] float4 fma_f4(float4 a, float4 b, float4 c) { return fma(a, b, c); }
[[stitchable]] float4 fma_f4_f(float4 a, float b, float4 c) { return fma(a, float4(b), c); }

// ============================================================================
// MARK: - Construction
// ============================================================================

[[stitchable]] float4 make_f4(float x, float y, float z, float w) { return float4(x, y, z, w); }
[[stitchable]] float4 make_f4_f2_f_f(float2 xy, float z, float w) { return float4(xy, z, w); }

// ============================================================================
// MARK: - Identity / Select
// ============================================================================

[[stitchable]] float identity_f(float x) { return x; }
[[stitchable]] float4 identity_f4(float4 x) { return x; }

// Select functions: consume unused input b, return a
[[stitchable]] float4 select_f4_f4(float4 a, float4 b) { return a; }
[[stitchable]] float4 select_f4_f2(float4 a, float2 b) { return a; }
[[stitchable]] float4 select_f4_f(float4 a, float b) { return a; }

} // namespace shadergraph

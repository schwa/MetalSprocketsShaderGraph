% for size in vector_sizes:
%{
vec_vt = vec_vt_fmt.format(size)
vec_suffix = suffix + str(size)
}%
        // ${vec_vt} vector-vector operations
% for op_name, _ in ops:
        registerFunction(named: "shadergraph::${op_name}_${vec_suffix}_${vec_suffix}", library: library, inputs: [.${vec_vt}, .${vec_vt}], output: .${vec_vt})
% end


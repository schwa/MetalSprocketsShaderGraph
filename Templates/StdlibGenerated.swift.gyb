        registerFunction(named: "shadergraph::${op_name}_${vec_suffix}_${suffix}", library: library, inputs: [.${vec_vt}, .${scalar_vt}], output: .${vec_vt})
% end

        // ${vec_vt} swizzles
% for comp in swizzle_components[:size]:
        registerFunction(named: "shadergraph::swizzle_${comp}_${vec_suffix}", library: library, inputs: [.${vec_vt}], output: .${scalar_vt})
% end

% end

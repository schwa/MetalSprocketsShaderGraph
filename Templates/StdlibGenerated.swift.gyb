import Metal

// MARK: - Generated Stdlib Registration

extension ShaderGraph {
    /// Register generated arithmetic operations from the stdlib metallib
    func registerGeneratedStdlib(library: MTLLibrary) {
% for suffix, scalar_vt, vec_vt_fmt in scalar_types:
        // --- ${suffix} (${scalar_vt}) ---
        
        // Scalar-scalar operations
% for op_name, _ in ops:
        registerFunction(named: "shadergraph::${op_name}_${suffix}_${suffix}", library: library, inputs: [.${scalar_vt}, .${scalar_vt}], output: .${scalar_vt})
